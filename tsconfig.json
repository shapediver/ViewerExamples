{
    "compilerOptions": {
        "module": "commonjs",
        "removeComments": false,
        "esModuleInterop": true,
        "sourceMap": false,
        "declaration": false,
        "declarationMap": false,
        "target": "ES6",
        "strict": true,
        "outDir": "dist",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "moduleResolution": "node",
        "types": ["node"],
        "ignoreDeprecations": "6.0",
        "skipLibCheck": true
    },
    "exclude": ["node_modules", "dist"]
}
